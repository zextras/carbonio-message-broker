MAIN_SERVICE_NAME="carbonio-message-broker"
CONSUL_TOKEN_PATH="/etc/carbonio/message-broker/service-discover/token"
RABBITMQ_NODE_NAME="carbonio-message-broker-clustered"

if [[ $(id -u) -ne 0 ]]; then
  echo "Please run as root"
  exit 1
fi

export PATH="$PATH:/opt/zextras/common/bin"

kv_get() {
  consul kv get -token-file="$CONSUL_TOKEN_PATH" "$1" 2>/dev/null
}

rmq() {
  rabbitmqctl --node "$RABBITMQ_NODE_NAME" "$@" >/dev/null 2>&1
}

setup_user() {
  local key="$MAIN_SERVICE_NAME/$1" username=$2 tags=$3
  local stored_username password
  stored_username=$(kv_get "$key/username")
  password=$(kv_get "$key/password")

  if [[ -n $stored_username && -n $password ]] && rmq authenticate_user "$stored_username" "$password"; then
    echo "User $username already exists"
  else
    if [[ $stored_username != "$username" ]]; then
      consul kv put -token-file="$CONSUL_TOKEN_PATH" "$key/username" "$username" || exit 1
    fi
    # Consumers cache this password: reuse it, and create it only if absent (a failed read looks like a missing key).
    if [[ -z $password ]]; then
      password=$(openssl rand -hex 16)
      if ! consul kv put -token-file="$CONSUL_TOKEN_PATH" -cas -modify-index=0 "$key/password" "$password"; then
        echo "Cannot store a new password for $username in Consul KV (already set or Consul unreachable), aborting"
        exit 1
      fi
    fi
    if rmq add_user "$username" "$password"; then
      rmq set_permissions -p / "$username" ".*" ".*" ".*"
      echo "User $username added"
    else
      rmq change_password "$username" "$password"
      echo "Changed password for the user $username"
    fi
  fi

  if [[ -n $tags ]]; then
    rmq set_user_tags "$username" "$tags"
  fi
}

setup_user "default" "$MAIN_SERVICE_NAME" ""
setup_user "admin" "$MAIN_SERVICE_NAME-admin" "administrator"

echo "Enabling feature flags..."
rabbitmqctl enable_feature_flag all --node "$RABBITMQ_NODE_NAME" >/tmp/rabbitmq_feature_flags.log 2>&1 || true
