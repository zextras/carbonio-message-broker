MAIN_SERVICE_NAME="carbonio-message-broker"
CONSUL_TOKEN_PATH="/etc/carbonio/message-broker/service-discover/token"
RABBITMQ_NODE_NAME="carbonio-message-broker-clustered"

die() {
  echo "$*" >&2
  exit 1
}

[[ $(id -u) -eq 0 ]] || die "Please run as root"

export PATH="$PATH:/opt/zextras/common/bin"

kv_get() {
  consul kv get -token-file="$CONSUL_TOKEN_PATH" "$1" 2>/dev/null
}

kv_put() {
  consul kv put -token-file="$CONSUL_TOKEN_PATH" "$@" >/dev/null
}

rmq() {
  rabbitmqctl --node "$RABBITMQ_NODE_NAME" "$@" >/dev/null 2>&1
}

# Consumers cache the password: reuse it, create it only if absent (a failed read looks like a missing key).
ensure_kv_credentials() {
  local key=$1 username=$2 password
  [[ $(kv_get "$key/username") == "$username" ]] || kv_put "$key/username" "$username" || return 1
  password=$(kv_get "$key/password")
  if [[ -z $password ]]; then
    password=$(openssl rand -hex 16)
    kv_put -cas -modify-index=0 "$key/password" "$password" || return 1
  fi
  echo "$password"
}

reconcile_rabbit_user() {
  local username=$1 password=$2 tags=$3
  if rmq authenticate_user "$username" "$password"; then
    echo "User $username already exists"
  elif rmq add_user "$username" "$password"; then
    echo "User $username added"
  else
    rmq change_password "$username" "$password"
    echo "Changed password for the user $username"
  fi
  rmq set_permissions -p / "$username" ".*" ".*" ".*"
  rmq set_user_tags "$username" ${tags:+"$tags"}
}

setup_user() {
  local key="$MAIN_SERVICE_NAME/$1" username=$2 tags=$3 password
  password=$(ensure_kv_credentials "$key" "$username") \
    || die "Cannot read or store credentials for $username in Consul KV, aborting"
  reconcile_rabbit_user "$username" "$password" "$tags"
}

setup_user "default" "$MAIN_SERVICE_NAME" ""
setup_user "admin" "$MAIN_SERVICE_NAME-admin" "administrator"

echo "Enabling feature flags..."
rabbitmqctl enable_feature_flag all --node "$RABBITMQ_NODE_NAME" >/tmp/rabbitmq_feature_flags.log 2>&1 || true
