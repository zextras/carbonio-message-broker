# Per-session queues and per-user exchanges left by carbonio-ws-collaboration < CO-4512; only deleted when unused.
RABBITMQ_COMMANDS_FOLDER="/opt/zextras/common/bin"
RABBITMQ_NODE_NAME="carbonio-message-broker-clustered"

export PATH="$PATH:$RABBITMQ_COMMANDS_FOLDER"

rabbitmqctl eval --node "$RABBITMQ_NODE_NAME" '
  Uuid = "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
  Queues = [Q || Q <- rabbit_amqqueue:list(<<"/">>),
    {resource, _, queue, Name} <- [amqqueue:get_name(Q)],
    re:run(Name, Uuid) =/= nomatch,
    amqqueue:get_type(Q) =:= rabbit_classic_queue,
    not amqqueue:is_durable(Q),
    amqqueue:is_auto_delete(Q),
    amqqueue:get_exclusive_owner(Q) =:= none],
  DeletedQueues = [Q || Q <- Queues,
    element(1, catch rabbit_amqqueue:delete(Q, true, false, <<"carbonio-message-broker">>)) =:= ok],
  Exchanges = [XName || X <- rabbit_exchange:list(<<"/">>),
    [{name, XName = {resource, _, exchange, Name}}, {type, direct}, {durable, false}]
      <- [rabbit_exchange:info(X, [name, type, durable])],
    re:run(Name, Uuid) =/= nomatch],
  DeletedExchanges = [XName || XName <- Exchanges,
    rabbit_exchange:delete(XName, true, <<"carbonio-message-broker">>) =:= ok],
  {legacy_ws_collaboration,
    {queues, {found, length(Queues)}, {deleted, length(DeletedQueues)}},
    {exchanges, {found, length(Exchanges)}, {deleted, length(DeletedExchanges)}}}.'
